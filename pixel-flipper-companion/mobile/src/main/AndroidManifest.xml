<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- NFC: read/write tags and host-card emulation. -->
    <uses-permission android:name="android.permission.NFC" />

    <!--
      Dispatching a target's action over HTTP. Local only in practice: a relay
      on a PC, a Home Assistant webhook, a Raspberry Pi.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.nfc.hce"
        android:required="false" />

    <!-- Bluetooth LE scanning (Android 12+ runtime perms). -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Legacy BLE perms for API < 31. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- Before Android 12, BLE scan results require fine location. -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <!--
      Cleartext is permitted because the things this dispatches to live on the
      home network and speak plain HTTP: a relay script, a hub, a Pi. Android
      has blocked cleartext by default since 9, and without this every dispatch
      to an http:// address fails with a cleartext-not-permitted error that
      reads like the device being unreachable.

      Use https:// wherever the far end offers it; this only removes the
      platform's refusal to try.
    -->
    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              A tag on the television starts this app and says which target it
              is. Without the system dispatching the tap, NFC would only work
              with the app already open and reader mode running, and an app you
              must open first is no quicker than the app's own buttons.
            -->
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="flipper" android:host="target" />
            </intent-filter>
        </activity>

        <!--
          Lets the snap-trace CSV be handed to another app (email, Drive) through
          the share sheet, so pulling it does not require adb. Not exported:
          access is only ever granted per-URI, per-share, via
          FLAG_GRANT_READ_URI_PERMISSION.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Host Card Emulation service: emulates an ISO-DEP (ISO 14443-4) card. -->
        <service
            android:name=".hce.CardEmulationService"
            android:exported="true"
            android:permission="android.permission.BIND_NFC_SERVICE">
            <intent-filter>
                <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.cardemulation.host_apdu_service"
                android:resource="@xml/apduservice" />
        </service>

        <!-- Receives trigger messages sent from the watch over the Data Layer. -->
        <service
            android:name=".wear.PhoneMessageListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/flipper" />
            </intent-filter>
        </service>
    </application>
</manifest>
